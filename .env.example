# ===== إعدادات منصة منهج =====

# --- محركات الذكاء الاصطناعي (ضع مفتاحاً واحداً على الأقل؛ كلها مجانية عدا Claude) ---
# Google Gemini (مجاني):  https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq (مجاني):           https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (نماذج مجانية): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Mistral (خطة Experiment مجانية): https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# Claude (مدفوع - اختياري): https://platform.claude.com
ANTHROPIC_API_KEY=

# ترتيب المحركات: الأول يكتب، والثاني يراجع ويحسّن، والبقية احتياط عند تجاوز الحد المجاني
AI_ENGINES=gemini,groq,openrouter,mistral,claude
# مراجعة كل جزء بمحرك ثانٍ (1 = نعم، 0 = لا)
AI_REVIEW=1
# يمكن تغيير النماذج إن تغيّرت أسماؤها لدى المزوّد:
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3.1:free
# MISTRAL_MODEL=mistral-large-latest
# CLAUDE_MODEL=claude-opus-5-5

# --- المدير ---
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me
SECRET_KEY=replace-with-a-long-random-string
# رابط المنصة العام (على Render يُضبط تلقائياً)
# BASE_URL=http://localhost:5000

# --- الإيميل ---
# الخيار 1 (موصى به، مجاني 300 رسالة/يوم): Brevo  https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
MAIL_FROM=you@gmail.com          # يجب توثيقه في Brevo > Senders
MAIL_FROM_NAME=منصة منهج

# الخيار 2: SMTP (مثلاً Gmail مع App Password) - يُستخدم إذا لم تضع BREVO_API_KEY
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=your-app-password
